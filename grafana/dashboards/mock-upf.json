{
  "uid": "mock-upf-demo",
  "title": "Mock UPF Overview",
  "tags": ["5G", "UPF", "demo"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Packet throughput",
      "description": "Received and transmitted packets per second.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "pps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "rate(upf_packets_received_total[$__rate_interval])", "legendFormat": "Received", "range": true },
        { "refId": "B", "expr": "rate(upf_packets_transmitted_total[$__rate_interval])", "legendFormat": "Transmitted", "range": true }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Packet drop rate",
      "description": "Dropped packets per second.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "pps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "rate(upf_packets_dropped_total[$__rate_interval])", "legendFormat": "Dropped", "range": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active sessions",
      "description": "Current simulated active sessions.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "refId": "A", "expr": "upf_active_sessions", "legendFormat": "Sessions", "range": true }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Per-lcore utilization",
      "description": "Utilization of each simulated logical core.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "upf_lcore_utilization_ratio", "legendFormat": "Lcore {{lcore}}", "range": true }
      ]
    }
  ]
}
